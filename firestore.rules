rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // House totals — anyone can read (public scoreboard), only logged-in admins can write
    match /houses/{houseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Result announcements — anyone can read, only logged-in admins can create.
    // No edits/deletes from the client, so the activity log can't be tampered with.
    match /announcements/{annId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
